        <mxCell id="advisor-legend-4" value="PK = khóa chính; FK = khóa ngoại; NN = bắt buộc; UQ = duy nhất; CHECK = điều kiện kiểm tra; “–” = cho phép trống.&lt;br&gt;Crow’s Foot: vòng tròn = 0; gạch = 1; chân quạ = nhiều. Nhãn cạnh là cột FK.&lt;br&gt;Các trang là lát cắt theo nhóm; liên kết giữa nhóm chưa thể hiện bằng đường nối — xem đầy đủ FK trong data-dictionary.md." style="text;html=1;whiteSpace=wrap;fillColor=#f1f5f9;strokeColor=#cbd5e1;rounded=0;fontSize=11;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=12;" parent="1" vertex="1">
