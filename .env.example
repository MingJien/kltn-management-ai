# Sao chép thành .env tại máy phát triển; không commit .env thật.
POSTGRES_DB=kltn_management
POSTGRES_USER=kltn_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://kltn_app:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/kltn_management

# Bật định danh giả lập chỉ trên máy phát triển hoặc test; production fail closed.
KLTN_ENV=development
KLTN_DEV_AUTH=false

# OIDC cũ là phương án tích hợp tùy chọn, chưa phải luồng đăng nhập chính.
# Phương án hiện tại: email/mật khẩu của ứng dụng; cấp tài khoản, kích hoạt và đặt lại mật khẩu đã có mã nguồn.
# Chỉ bật OIDC nếu CNTT Trường cấp thông tin và tài khoản được liên kết external_subject = claim `sub`.
# AUTH_SESSION_SECRET phải là chuỗi ngẫu nhiên dài; giữ bí mật và không dùng giá trị ví dụ.
AUTH_SESSION_SECRET=
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
OIDC_SCOPE=openid
KLTN_FRONTEND_URL=http://localhost:5173

# Gửi liên kết kích hoạt/đặt lại mật khẩu. Thiếu SMTP trong DEV/TEST: thư được ghi vào tmp/mail-outbox (Git bỏ qua).
# Production yêu cầu HTTPS frontend, AUTH_SESSION_SECRET ổn định và SMTP có STARTTLS.
KLTN_MAIL_FROM=
KLTN_SMTP_HOST=
KLTN_SMTP_PORT=587
KLTN_SMTP_USER=
KLTN_SMTP_PASSWORD=
KLTN_BOOTSTRAP_ADMIN_EMAIL=

# Qdrant service của docker-compose; nếu Docker không chạy, dùng QDRANT_LOCAL_PATH=tmp/qdrant-prototype.
QDRANT_URL=http://127.0.0.1:6333
